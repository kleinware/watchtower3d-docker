# Copy to .env and adjust for this machine. .env is git-ignored.
# Shared by both docker-compose.yml (Tailscale) and docker-compose.standalone.yml;
# each file just ignores the variables it doesn't use.

TZ=America/New_York

# Watchtower installer placed next to the Dockerfile (download from watchtower3d.com)
WATCHTOWER_DEB=Watchtower-x.y.z-linux-x86_64.deb

# Owner of the appdata folders below; baked into the image at build time
# (rebuild with `docker compose up -d --build` after changing). Unraid: 99 / 100.
PUID=1000
PGID=1000

# Appdata paths (must be writable by PUID:PGID)
WATCHTOWER_DATA_PATH=/path/to/appdata/watchtower/data
TS_STATE_PATH=/path/to/appdata/watchtower/tailscale

# Tailscale sidecar (docker-compose.yml only). Hostname on the tailnet:
TS_HOSTNAME=watchtower
# Optional reusable/ephemeral auth key from https://login.tailscale.com/admin/settings/keys
# Leave empty to log in interactively (the sidecar's `tailscale up` step times out after 60s,
# so an auth key is the reliable way to authenticate a fresh state dir).
TS_AUTHKEY=

# Standalone, no Tailscale (docker-compose.standalone.yml only): host port for the web UI.
# Ignored by docker-compose.yml.
WATCHTOWER_WEB_PORT=8080
